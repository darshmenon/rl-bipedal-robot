  <!-- High friction on both soles: undefined friction plus a narrow foot
       (see the ankle collision comments above) let the robot slide out from
       under itself before any PD gain tuning could help. -->
  <gazebo reference="left_ankle_link">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="right_ankle_link">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- Joint position control: native gz-sim JointPositionController per joint,
       same fix as bipedal_robot_description/urdf/bipedal.urdf: gz_ros2_control
       is ABI-broken against this system's default Gazebo Harmonic (gz-sim8).
       Commands arrive over each joint's <topic> below, bridged by
       ros_gz_bridge. (The plugin's own default topic has an axis-index
       segment starting with a digit, which is a valid gz-transport name but
       an invalid ROS 2 one, see standing_pose_publisher.py's docstring.)

       Leg joint p_gain/d_gain/cmd_max match unitree_rl_gym's
       deploy/deploy_mujoco/configs/h1.yaml kps/kds and H1's real effort
       limits exactly, so Gazebo's joint tracking compliance matches what
       the pretrained walk policy (h1_rl_walk_publisher.py, controller:=walk)
       was trained against. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <!-- Ground-truth pelvis pose/twist for standing_pose_publisher.py's tilt
         feedback, a real rclpy subscription callback via this bridged
         topic, not the subprocess-polling `gz topic -e` it used to fall
         back on (spawn overhead alone could exceed its own 20ms timeout). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>pelvis</robot_base_frame>
      <!-- Publishes on global /odometry in this gz-sim version; the launch
           file bridges that topic and remaps it to /model/h1/odometry. -->
      <odom_topic>odometry</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_hip_yaw_joint</joint_name>
      <topic>/model/h1/joint/left_hip_yaw_joint/cmd_pos</topic>
      <p_gain>150</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <i_max>0</i_max>
      <i_min>-0</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_hip_roll_joint</joint_name>
      <topic>/model/h1/joint/left_hip_roll_joint/cmd_pos</topic>
      <p_gain>150</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <i_max>0</i_max>
      <i_min>-0</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_hip_pitch_joint</joint_name>
      <topic>/model/h1/joint/left_hip_pitch_joint/cmd_pos</topic>
      <p_gain>150</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
      <i_max>0</i_max>
      <i_min>-0</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_knee_joint</joint_name>
      <topic>/model/h1/joint/left_knee_joint/cmd_pos</topic>
      <p_gain>200</p_gain>
      <i_gain>0</i_gain>
      <d_gain>4</d_gain>
      <i_max>0</i_max>
      <i_min>-0</i_min>
      <cmd_max>300</cmd_max>
      <cmd_min>-300</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_ankle_joint</joint_name>
      <topic>/model/h1/joint/left_ankle_joint/cmd_pos</topic>
      <p_gain>40</p_gain>
      <i_gain>0</i_gain>
