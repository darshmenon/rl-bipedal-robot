  <!-- 3D lidar: Unitree Mid-360 mount point, 16-channel VLP-16-style gpu_lidar
       (same params as quadruped-dog-rl's proven lidar3d sensor for Go2's RTAB-Map
       pipeline). mid360_joint already bakes in the mount tilt, so the sensor pose
       here is identity. Needs the Sensors system plugin loaded at the world level
       (see worlds/h1_lidar_world.sdf; ros_gz_sim's stock empty.sdf doesn't have it).
  -->
  <gazebo reference="mid360_link">
    <sensor name="mid360_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>points</topic>
      <gz_frame_id>mid360_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <min_angle>-0.1745</min_angle>
            <max_angle>0.1745</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
